generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id             String    @id
  email          String    @unique @db.VarChar(255)
  emailVerified  Boolean   @default(false)
  name           String    @db.VarChar(255)
  image          String?   @db.VarChar(500)
  password       String?   @db.VarChar(255)
  user_name      String?   @unique @db.VarChar(255)
  unique_code    String?   @unique @db.VarChar(255)
  phone          String?   @db.VarChar(180)
  country        String?   @db.VarChar(180)
  birth_date     DateTime?
  role           Int       @default(2) @db.SmallInt
  status         Int       @default(0) @db.SmallInt
  email_verified Int       @default(0) @db.SmallInt
  phone_verified Int       @default(0) @db.SmallInt
  gender         Int       @default(1) @db.SmallInt
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  login_provider String?   @db.VarChar(50)

  UserTokens            UserTokens[]
  UserVerificationCodes UserVerificationCodes[]
  Presentations         Presentation[]
  Media                 Media[]
  Themes                Theme[]
  Layouts               Layout[]
  Outlines              Outline[]
  Subscription          Subscription?
  CreditBalance         CreditBalance?
  CreditTransactions    CreditTransaction[]
  AiUsages              AiUsage[]
  SystemActivities      SystemActivity[]
  BlogPosts             BlogPost[]
  sessions              Session[]
  accounts              Account[]

  @@index([id])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model UserTokens {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @db.Text
  family       String   @db.VarChar(255)
  browserInfo  String?  @db.VarChar(255)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}

model UserVerificationCodes {
  id         String   @id @default(cuid())
  userId     String
  code       String   @unique @db.VarChar(10)
  status     Int      @default(0) @db.SmallInt
  type       Int      @default(1) @db.SmallInt
  expired_at DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Presentation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String  @default("Untitled Presentation")
  description String?
  thumbnail   String? @db.VarChar(500)

  globalTheme Json @default("{}")

  isPublic   Boolean  @default(false)
  isTemplate Boolean  @default(false)
  tags       String[]

  version    Int     @default(1)
  parentId   String?
  forkedFrom String?

  sharedWith String[]
  ownerId    String

  deletedAt DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastViewedAt DateTime?

  slides    Slide[]
  versions  PresentationVersion[]
  analytics PresentationAnalytics?
  views     PresentationView[]

  @@index([userId])
  @@index([ownerId])
  @@index([deletedAt])
  @@index([isPublic])
  @@index([isTemplate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([parentId])
  @@index([forkedFrom])
  @@map("presentations")
}

model PresentationVersion {
  id             String       @id @default(cuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  title       String
  globalTheme Json
  version     Int
  changeNote  String?

  createdAt DateTime @default(now())
  createdBy String?

  @@index([presentationId])
  @@index([createdAt])
  @@map("presentation_versions")
}

model Slide {
  id             String       @id @default(cuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  data  Json @default("{}")
  order Int

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([presentationId])
  @@index([presentationId, order])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("slides")
}

model PresentationAnalytics {
  id             String       @id @default(cuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  viewCount    Int       @default(0)
  uniqueViews  Int       @default(0)
  lastViewedAt DateTime?

  avgViewDuration Int?
  completionRate  Float?

  shareCount    Int @default(0)
  downloadCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([presentationId])
  @@index([viewCount])
  @@index([lastViewedAt])
  @@map("presentation_analytics")
}

model PresentationView {
  id             String       @id @default(cuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  userId    String?
  sessionId String
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)

  duration     Int?
  slidesViewed Int[]
  completed    Boolean @default(false)

  viewedAt DateTime @default(now())

  @@index([presentationId])
  @@index([userId])
  @@index([viewedAt])
  @@index([sessionId])
  @@map("presentation_views")
}

model Media {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String @db.VarChar(255)
  url      String @db.VarChar(1000)
  mimeType String @db.VarChar(100)
  size     Int // Size in bytes
  width    Int?
  height   Int?

  tags       String[]
  isFavorite Boolean  @default(false)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([createdAt])
  @@index([isFavorite])
  @@map("media")
}

model Theme {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(255)
  description String? @db.VarChar(500)

  // Theme data stored as JSON for better scalability
  themeData Json @default("{}")

  // Admin themes are official themes created by admins
  isAdmin Boolean @default(false)

  // Usage stats
  usageCount Int @default(0)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isAdmin])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("themes")
}

model Layout {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(255)
  description String? @db.VarChar(500)
  thumbnail   String? @db.VarChar(500)

  // Layout/template data stored as JSON (similar to Slide data)
  // Contains slide structure, widgets, and layout configuration
  data Json @default("{}")

  // Template type: "admin" for admin-created templates, "user" for user-created templates
  type String @default("user") @db.VarChar(50)

  // Category/tags for organizing layouts
  tags String[]

  // Usage stats
  usageCount Int @default(0)

  isAdmin Boolean @default(true)
  published Boolean @default(true)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([usageCount])
  @@index([published])
  @@map("layouts")
}

model Outline {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  prompt         String @db.Text
  numberOfSlides Int

  title    String?
  outlines Json? // Array of { content: string, layoutId?: string }
  status   String  @default("generating") // generating, completed, failed

  presentationId String? // Link to presentation if created from this outline

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("outlines")
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Polar.sh subscription data
  polarSubscriptionId String? @unique @db.VarChar(255)
  polarCustomerId     String? @db.VarChar(255)
  status              String  @default("inactive") @db.VarChar(50) // active, inactive, canceled, past_due
  productId           String? @db.VarChar(255)
  priceId             String? @db.VarChar(255)

  // Subscription details
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  // Metadata
  metadata Json? @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([polarSubscriptionId])
  @@index([status])
  @@map("subscriptions")
}

model CreditBalance {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Single source of truth for UI
  balance Int @default(30)
  
  // The total entitlement for the current cycle
  quota   Int @default(30)

  // Tracking for analytics
  usedCredits Int @default(0)

  // Last reset/purchase date
  lastResetAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("credit_balances")
}

model CreditTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Transaction details
  amount      Int // Positive for credits added, negative for credits used
  type        String  @db.VarChar(50) // purchase, usage, refund, bonus, reset
  description String? @db.VarChar(500)

  // Related entities
  presentationId String?
  subscriptionId String?

  // Balance after transaction
  balanceAfter Int

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("credit_transactions")
}

model AiUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Technical details
  modelName    String
  inputTokens  Int
  outputTokens Int
  cost         Float // Actual cost in USD
  provider     String @default("openrouter")

  // Success tracking
  isSuccess    Boolean @default(true)
  errorMessage String? @db.Text

  // Context
  type           String // outline, slides, image
  presentationId String?
  outlineId      String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([isSuccess])
  @@map("ai_usages")
}

model GlobalConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("global_configs")
}

model PromoCode {
  id    String @id @default(cuid())
  code  String @unique
  type  String // percentage, fixed
  value Float

  maxUses Int?
  used    Int @default(0)

  productId String? // If specific to a plan
  
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@map("promo_codes")
}

model SystemActivity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action      String // login, registration, presentation_create, presentation_export, etc.
  description String? @db.Text
  ipAddress   String? @db.VarChar(45)
  userAgent   String? @db.VarChar(500)
  
  metadata Json? @default("{}")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("system_activities")
}
model BlogPost {
  id    String @id @default(cuid())
  title String
  slug  String @unique
  
  // Content
  content     Json    @default("{}") // Rich content structure
  excerpt     String? @db.Text
  featuredImg String? @db.VarChar(500)
  
  // Status & Publication
  status      String   @default("draft") // draft, published, scheduled
  publishedAt DateTime?
  
  // Relations
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])
  tags       BlogTag[]
  
  // SEO Metadata
  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.Text
  metaKeywords    String? @db.Text
  canonicalUrl    String? @db.VarChar(500)
  ogImage         String? @db.VarChar(500)
  
  // Stats
  viewCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@map("blog_posts")
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  
  posts BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_categories")
}

model BlogTag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
  
  posts BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_tags")
}
